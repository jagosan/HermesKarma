# ==============================================================================
# Hermes Karma Configuration Template (.env.example)
# Copy this file to .env and customize values for your homelab or cluster setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Directory Paths
# ------------------------------------------------------------------------------
# Location of Hermes Agent state database, skills, and configuration:
# HERMES_HOME=~/.hermes

# Location of Hermes Karma metadata database and live session tracking:
# HERMES_KARMA_HOME=~/.hermes_karma

# ------------------------------------------------------------------------------
# Webhook Secrets (Optional - for cross-referencing PRs / tasks)
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Fleet & Multi-Node Inference Telemetry Configuration
# ------------------------------------------------------------------------------

# Local Coordinator Node (e.g. primary host running Hermes Karma)
COORDINATOR_NODE_ID=beehive
COORDINATOR_NODE_NAME=Beehive (Coordinator)
COORDINATOR_HOST=localhost
COORDINATOR_TAILSCALE_IP=
LOCAL_OLLAMA_PORT=11434

# Remote Inference Worker Node (e.g. dedicated APU/GPU node over Tailscale or LAN)
REMOTE_WORKER_NODE_ID=chunkito
REMOTE_WORKER_NODE_NAME=Chunkito (AMD APU Inference)
CHUNKITO_HOST=
CHUNKITO_TAILSCALE_IP=
CHUNKITO_OLLAMA_PORT=11434
REMOTE_WORKER_VRAM_GB=118
REMOTE_WORKER_GTT_SIZE_MB=120832
REMOTE_WORKER_MAX_LOADED_MODELS=1
